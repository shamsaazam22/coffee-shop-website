<!-- Contact Section -->
 <section id="contact">
    <div class="container">
        <div class="row">
            <div class="col-md-7">
                <div class="heading">contact <span>us</span></div>
                <p>We’re here to help! Whether you have a question about our coffee, 
                    want to give feedback, or just want to say hello — we’d love
                    to hear from you. Feel free to reach out through the contact form below,
                    email us, or visit us at our café. Our team is always ready to serve you 
                    with warmth and a perfect cup of coffee.</p>
                    <input type=" text" placeholder="Name" class="form-control mb-3" aria-label="default input example">
                    <input type=" email" placeholder="email" class="form-control mb-3" aria-label="default input example">
                    <input type="number" placeholder="phone" class="form-control mb-3" aria-label="default input example">
                    <button id="contact-btn">send message</button>
            </div>
            <div class="col-md-5" id="col">
                <h1>info</h1>
                <p><i class="fa-regular fa-envolope"></i>example@gmail.com</p>
                <p><i class="fa-solid fa-phone"></i>92+000000000000</p>
                <p><i class="fa-solid fa-building-coluns"></i>karachi, sindh, pakistan</p>
                <p>Get in Touch
For inquiries, orders, or general info, feel free to contact us anytime. We're always happy to assist you!</p>
